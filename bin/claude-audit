#!/bin/bash
set -eu
umask 077
base="$HOME/Library/Logs/claude-route-audit"
mkdir -p "$base"
run=$(mktemp -d "$base/$(date +%Y%m%d-%H%M%S).XXXXXX")
printf 'Каталог теста: %s\n' "$run" >&2
# Monitor only this CLI process. Never record packet payloads or environment.
pid=$$
(
  while kill -0 "$pid" 2>/dev/null; do
    printf '\n%s\n' "$(date -u +%FT%TZ)"
    /usr/sbin/lsof -nP -a -p "$pid" -i -F pcnT 2>/dev/null || :
    sleep 1
  done
) </dev/null >"$run/connections.log" 2>/dev/null &
exec "$HOME/.local/bin/claude" --debug-file "$run/claude-debug.log" --verbose "$@"
