#!/bin/bash
set -eu
host=my-germany-server
port=15947
ctl="$HOME/.ssh/claude-vnc-control"
ssh_opts=(-a -o BatchMode=yes -o ConnectTimeout=8)
if [[ ${1:-} == --stop ]]; then
  ssh "${ssh_opts[@]}" -S "$ctl" -O exit "$host" 2>/dev/null || true
  ssh "${ssh_opts[@]}" "$host" 'systemctl stop chrome-vps.service'
  exit
fi
if ! ssh "${ssh_opts[@]}" "$host" 'test -f /var/lib/chrome-view/.vnc/password-set'; then
  echo 'Задай пароль VNC (8 символов), затем введи его в Screen Sharing.'
  ssh "${ssh_opts[@]}" -t "$host" 'runuser -u chrome-view -- tigervncpasswd /var/lib/chrome-view/.vnc/passwd && touch /var/lib/chrome-view/.vnc/password-set'
fi
ssh "${ssh_opts[@]}" "$host" 'systemctl enable --now chrome-vps.service && for n in $(seq 1 40); do test ! -S /run/chrome-view/view.sock || exit 0; sleep .25; done; exit 1'
if ! ssh "${ssh_opts[@]}" -S "$ctl" -O check "$host" 2>/dev/null; then
  ssh "${ssh_opts[@]}" -M -S "$ctl" -fNT -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L "127.0.0.1:$port:/run/chrome-view/view.sock" "$host"
fi
open "vnc://127.0.0.1:$port"
